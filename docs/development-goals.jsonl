{"type":"field","key":"qualityModel","value":{"schema":"lumen-quality-score-v1","targetScore":0.99,"unit":"fraction","formula":"sum(component.score × component.weight)","normalization":"each component is capped to [0, 1]; missing evidence is 0 and fails closed","components":[{"id":"scenario-contract","weight":0.12,"target":8,"formula":"valid scenario dimensions / 8","evidence":"tool/verify_game.dart#scenario-contract"},{"id":"choice-impact","weight":0.12,"target":1.0,"formula":"effectful authored choices / authored choices","evidence":"build/gameplay-fun-verdict.json#metrics.choiceImpactRate"},{"id":"event-divergence","weight":0.1,"target":1.0,"formula":"events with distinct authored effects / events","evidence":"build/gameplay-fun-verdict.json#metrics.eventDivergenceRate"},{"id":"multi-axis-choice","weight":0.1,"target":0.9,"formula":"choices changing at least two numeric axes / choices","evidence":"build/gameplay-fun-verdict.json#metrics.multiAxisImpactRate"},{"id":"gated-choice","weight":0.08,"target":20,"formula":"min(gated authored choices / 20, 1)","evidence":"build/gameplay-fun-verdict.json#metrics.gatedChoices"},{"id":"chapter-event-golden","weight":0.1,"target":16,"formula":"chapter event Goldens / 16","evidence":"test/goldens/chapter-*.png"},{"id":"chapter-closure-golden","weight":0.1,"target":16,"formula":"chapter closure Goldens / 16","evidence":"test/goldens/chapter-closure-*.png"},{"id":"locale-coverage","weight":0.08,"target":505,"formula":"minimum locale catalog keys / 505","evidence":"story/locales/{ko,en}.jsonl#catalog"},{"id":"replay-determinism","weight":0.1,"target":1.0,"formula":"benchmark checksum == replayChecksum and approved","evidence":"build/benchmark-verdict.json#checksumReplayMustMatch"},{"id":"runtime-proof","weight":0.1,"target":1.0,"formula":"decision proof + gameplay proof + benchmark all approve","evidence":"build/{decision-proof,gameplay-fun,benchmark}-verdict.json"}]}}
